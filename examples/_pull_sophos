#!/bin/bash

# Sophos Central SIEM events via the pull connector.
#
# One-time setup: Sophos hands you a tenant id and a regional API host, both permanent.
# Fetch them once and paste the results below.
#
#   TOKEN=$(curl -s -X POST https://id.sophos.com/api/v2/oauth2/token \
#       -d "grant_type=client_credentials&scope=token&client_id=$CID&client_secret=$SECRET" \
#       | jq -r .access_token)
#   curl -s -H "Authorization: Bearer $TOKEN" https://api.central.sophos.com/whoami/v1
#   # => { "id": "<tenant-id>", "idType": "tenant", "apiHosts": { "dataRegion": "https://api-eu01..." } }
#
# This assumes tenant credentials (idType "tenant"). Partner and organization credentials
# return their own id, not a tenant id.

# The secret is passed inline rather than exported, so it stays out of the rest of the
# shell session and out of the process list.
ILERT_PULL_OAUTH_SECRET='<sophos client secret>' ilagent daemon -v \
    --file ./ilagent-sophos.db3 \
    --pull_url https://api-eu01.central.sophos.com/siem/v1/events \
    --pull_header 'X-Tenant-ID=<tenant-id>' \
    --pull_items_path items \
    --pull_cursor next_cursor=cursor \
    --pull_oauth_url https://id.sophos.com/api/v2/oauth2/token \
    --pull_oauth_client_id '<sophos client id>' \
    --pull_oauth_scope token \
    --event_key 'il1api...' \
    --map_key_alert_key id \
    --map_key_summary name \
    --forward_message_payload

# --map_key_alert_key id lets ilert fold a record that is delivered twice (a page fetched
# again after a failed cycle). --forward_message_payload carries the rest of the record
# (type, severity, location, when) into customDetails for ilert's event templating.
#
# Sophos keeps 24 hours of data. A cursor older than that falls back to the last 24 hours,
# so events from a longer outage of the agent are not fetched.
#
# Sophos exposes alerts on a second endpoint. Run it as its own agent with its own --file;
# the stored cursor is keyed by the url path, so the two never share one. Alerts carry
# their text in `description` instead of `name`:
#
# ILERT_PULL_OAUTH_SECRET='<sophos client secret>' ilagent daemon -v \
#     --file ./ilagent-sophos-alerts.db3 \
#     --pull_url https://api-eu01.central.sophos.com/siem/v1/alerts \
#     --map_key_summary description \
#     ... other flags as above ...
