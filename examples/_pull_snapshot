#!/bin/bash

# Snapshot sources: on-prem systems that return the current set of open problems on
# every request, with no cursor to resume from. Deduplication does the work instead.

# Zabbix (JSON-RPC, so it needs a request body and therefore POST)

# The auth value is passed by environment rather than by flag, so the token does not show
# up in the process list, and inline rather than exported so it does not linger in the
# rest of the shell session. --pull_auth header is what makes it get sent.
ILERT_PULL_AUTH_VALUE='Bearer <zabbix api token>' ilagent daemon -v -v \
    --pull_url http://zabbix.internal/api_jsonrpc.php \
    --pull_name zabbix-problems \
    --pull_interval 60 \
    --pull_body '{"jsonrpc":"2.0","method":"problem.get","params":{"output":"extend"},"id":1}' \
    --pull_auth header --pull_auth_header Authorization \
    --pull_items_path result \
    --pull_cursor_mode none \
    --pull_dedup_key eventid \
    --event_key 'il1api...' \
    --map_key_summary name \
    --map_key_alert_key eventid

