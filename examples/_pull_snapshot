#!/bin/bash

# A snapshot source: the API returns the current set of open alerts on every request and
# has no cursor. Every poll sends every record; ilert folds the repeats by alertKey.
# Records that disappear from the response do not resolve their alerts.

ilagent daemon -v \
    --file ./ilagent-monitoring.db3 \
    --pull_url https://monitoring.internal/api/alerts/open \
    --pull_interval 120 \
    --pull_header 'X-API-Key=<api key>' \
    --pull_items_path data \
    --event_key 'il1api...' \
    --map_key_alert_key id \
    --map_key_summary title \
    --port 8977

# --port also serves /ready, which turns 503 while the last poll failed.
