#!/bin/bash

# Script delivery with health endpoint and HA mode
ILERT_EDGE_CONNECTOR_KEY='iec1...' ilagent daemon -v -v -p 8977 \
    --edge_mode script \
    --edge_script /opt/scripts/handle_event.sh \
    --edge_cluster_id prod-cluster \
    --edge_instance_id node-1

